{
  "name": "ivanzhuck/wordpress-sandbox",
  "description": "WordPress with Bedrock Boilerplate",
  "keywords": [
    "blog",
    "cms",
    "wordpress"
  ],
  "type": "project",
  "license": [
    "MIT",
    "GPL-2.0-or-later"
  ],
  "authors": [
    {
      "name": "Ivan Zhuck",
      "email": "i.a.zhuck@gmail.com",
      "homepage": "https://izhuck.ru",
      "role": "Developer"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": ["wpackagist-plugin/*", "wpackagist-theme/*"]
    },
    {
      "type": "path",
      "url": "local-plugins/*"
    },
    {
      "type": "path",
      "url": "local-themes/*"
    },
    {
      "type": "package",
      "package": {
        "name": "local-theme/izwp",
        "version": "1.0",
        "type": "wordpress-theme",
        "dist": {
          "type": "path",
          "url": "local-themes/izwp/wp-theme"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.4",
    "composer/installers": "^2.3",
    "vlucas/phpdotenv": "^5.6.4",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.1.0",
    "roots/bedrock-disallow-indexing": "^2.1.0",
    "roots/wordpress": "7.0.3",
    "roots/wp-config": "1.0.0",
    "wpackagist-theme/twentytwentythree": "1.6",
    "wp-cli/wp-cli-bundle": "2.12.0",
    "woocommerce/action-scheduler": "^4.1",
    "local-theme/izwp": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.4"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": ["type:wordpress-muplugin", "woocommerce/action-scheduler"],
      "web/app/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/app/themes/{$name}/": ["type:wordpress-theme"]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "post-root-package-install": [
      "php -r \"copy('.env.example', '.env');\""
    ]
  }
}
